{
  "_meta": {
    "purpose": "Canonical index registry. This is the JOIN KEY between a US-domiciled holding and its non-US-situs alternative. Discovery happens here, on index identity; return statistics only VERIFY a match, never discover one. Correlation is deliberately not used as a matching mechanism -- every US large-cap equity ETF correlates above 0.98 with every other one, so correlation cannot distinguish an S&P 500 tracker from a Nasdaq-100 tracker and would return confident wrong answers.",
    "built": "2026-08-02",
    "field_notes": {
      "label": "Display name of the index.",
      "provider": "Index provider. Two indices from different providers over the same exposure (e.g. S&P 500 vs MSCI USA) are a tier-2 match, not tier-1.",
      "exposure": "Plain-language description of what is actually owned.",
      "n_holdings": "Approximate constituent count. A large gap in this number between two indices is the clearest signal that a swap changes the portfolio -- CRSP US Total Market holds roughly 3600 names, the S&P 500 holds 500.",
      "family": "Indices sharing a family cover materially the same exposure and are eligible for tier-2 matching. Indices in different families are never matched."
    }
  },
  "near_families": {
    "_note": "Tier-2 matching across families. Same-family pairs are close substitutes; the pairs below are NOT, and each carries the reason the swap changes the portfolio. The match engine must surface the caveat verbatim alongside any tier-2 result -- an unexplained tier-2 match is the failure mode where someone swaps a total-market holding for a large-cap one and never learns they dropped 3,100 companies.",
    "pairs": [
      {
        "a": "us_total",
        "b": "us_large",
        "caveat": "No UCITS fund tracks CRSP US Total Market. The nearest available exposure is US large-cap, which holds roughly 500 to 600 companies against the total market's 3,600. You keep about 85 per cent of the market capitalisation and lose the small-cap tail entirely."
      },
      {
        "a": "us_small",
        "b": "us_total",
        "caveat": "A US small-cap holding swapped into a total-market or large-cap line is not a substitute -- it removes the small-cap tilt that was the point of the position."
      }
    ]
  },
